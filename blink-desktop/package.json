{
  "name": "blink-desk-buddy",
  "productName": "Blink",
  "version": "0.1.0",
  "description": "Blink Desk Buddy: a cute 3D desktop companion that runs without admin rights.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . Blink --platform=win32 --arch=x64 --out=dist --overwrite --asar.unpack=**/*.node --ignore=^/dist --ignore=^/start-blink.cmd --ignore=^/test-visible.ps1"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.2.1"
  }
}
